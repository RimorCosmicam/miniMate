<?xml version="1.0" encoding="utf-8"?>
<!--
  One block. There is no room for the name at this size, so the three toggles are the whole widget
  — which is the part anyone puts it there to reach anyway.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_card"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_speaker"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_speaker"
        android:contentDescription="Speaker" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="Microphone" />

    <ImageView
        android:id="@+id/widget_camera"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_widget_camera"
        android:contentDescription="Camera" />
</LinearLayout>
