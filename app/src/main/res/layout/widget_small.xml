<?xml version="1.0" encoding="utf-8"?>
<!--
  The small face: the mark, then the three toggles as a two-by-two with the last cell empty.
  Each is lit when its part of the app is running and dim when it is not, which is the same rule
  every control in the app follows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_wordmark_light"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="mini"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/mont_thin"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_wordmark_black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mate"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/mont_black"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_speaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_speaker"
            android:contentDescription="Speaker" />

        <ImageView
            android:id="@+id/widget_mic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_mic"
            android:contentDescription="Microphone" />

        <ImageView
            android:id="@+id/widget_camera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:src="@drawable/ic_widget_camera"
            android:contentDescription="Camera" />
    </LinearLayout>
</LinearLayout>
