<?xml version="1.0" encoding="utf-8"?>
<!-- A line: the name at one end, the three toggles at the other. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/widget_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"
        android:contentDescription="MiniMate" />

    <ImageView
        android:id="@+id/widget_speaker"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="7dp"
        android:src="@drawable/ic_widget_speaker"
        android:contentDescription="Speaker" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="7dp"
        android:src="@drawable/ic_widget_mic"
        android:contentDescription="Microphone" />

    <ImageView
        android:id="@+id/widget_camera"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:padding="7dp"
        android:src="@drawable/ic_widget_camera"
        android:contentDescription="Camera" />
</LinearLayout>
