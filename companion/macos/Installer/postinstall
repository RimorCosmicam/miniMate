#!/bin/zsh
set -u

app_path="/Applications/MiniMate Audio.app"
driver_path="/Library/Audio/Plug-Ins/HAL/MiniMateAudio.driver"
camera_path="/Library/CoreMediaIO/Plug-Ins/DAL/MiniMateCamera.plugin"

if [[ ! -x "$app_path/Contents/MacOS/MiniMateAudio" ]]; then
  echo "MiniMate application payload is missing" >&2
  exit 1
fi
if [[ ! -x "$driver_path/Contents/MacOS/MiniMateAudio" ]]; then
  echo "MiniMate CoreAudio driver payload is missing" >&2
  exit 1
fi
if [[ ! -x "$camera_path/Contents/MacOS/MiniMateCamera" ]]; then
  echo "MiniMate camera plug-in payload is missing" >&2
  exit 1
fi

# pkgbuild's recommended ownership already installs these as root:wheel. Keep
# normalization best-effort so an unusual runner ACL cannot invalidate a complete payload.
/usr/sbin/chown -R root:wheel "$app_path" "$driver_path" "$camera_path" || true
/bin/chmod -R a+rX "$app_path" "$driver_path" "$camera_path" || true
/usr/bin/xattr -dr com.apple.quarantine "$app_path" "$driver_path" "$camera_path" 2>/dev/null || true

# Register the application immediately and reload CoreAudio so the virtual
# speaker and microphone become visible without a reboot.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
  -f "$app_path" >/dev/null 2>&1 || true
/usr/bin/killall coreaudiod >/dev/null 2>&1 || true
# Camera clients cache DAL bundles. Relaunched apps discover MiniMate Camera;
# killing this helper is harmless when it is not running.
/usr/bin/killall VDCAssistant >/dev/null 2>&1 || true
/usr/bin/killall AppleCameraAssistant >/dev/null 2>&1 || true

# Open in the signed-in desktop session. This is what allows macOS itself to
# present the Local Network and Bluetooth privacy prompts to the user.
console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
if [[ -n "$console_user" && "$console_user" != "root" && "$console_user" != "loginwindow" ]]; then
  console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
  if [[ "$console_uid" == <-> ]]; then
    /usr/bin/sudo -u "$console_user" /bin/launchctl asuser "$console_uid" \
      /usr/bin/open "$app_path" >/dev/null 2>&1 || true
  fi
fi

exit 0
